# Backend only. Supabase session pooler connection, sslmode=require.
DATABASE_URL=
# Local administration only, never sent to frontend. Runtime URL uses a limited role.
DATABASE_ADMIN_URL=
EXPERIMENT_ID=survival-002
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Phase 2 has a distinct Azure deployment; the phase 1 value stays unchanged.
AZURE_OPENAI_DEPLOYMENT_PHASE2=gpt-6.1-sol-2
# Frontend public credentials only; never put DB or Azure secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_EXPERIMENT_ID=survival-002
# Opt-in integration checks
RUN_NETWORK_TESTS=0
TEST_DATABASE_URL=
AZURE_INPUT_USD_PER_MILLION=
AZURE_OUTPUT_USD_PER_MILLION=
# Optional dedicated GitHub fine-grained token for the Supabase watchdog.
# Local activation only; stored encrypted in Vault. Never use a VITE_ prefix.
SURVIVAL_SCHEDULER_GITHUB_TOKEN=
# Local Cloudflare watchdog deployment, account-scoped Workers Scripts Write.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Phase 3 operational API; admin token is backend-only, generated by deploy.
COUNCIL_API_URL=
COUNCIL_ADMIN_TOKEN=
COUNCIL_NTFY_TOPIC=
COUNCIL_GITHUB_NOTIFIER_TOKEN=
AZURE_OPENAI_DEPLOYMENT_PHASE3=gpt-6.1-sol-3
